<Window
	x:Class="StarMap.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="using:StarMap"
	mc:Ignorable="d"
	Title="StarMap — Eyes on the Solar System">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- ======================= Header ======================= -->
		<Grid Grid.Row="0" Padding="20,10"
			  Background="{ThemeResource LayerFillColorDefaultBrush}"
			  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
			  BorderThickness="0,0,0,1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
				<FontIcon Glyph="&#xE707;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
				<StackPanel Spacing="0">
					<TextBlock Text="StarMap" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
					<TextBlock Text="Eyes on the Solar System" Style="{StaticResource CaptionTextBlockStyle}"
							   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</StackPanel>
			</StackPanel>

			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
				<Button x:Name="NowButton" Click="NowButton_Click" ToolTipService.ToolTip="Jump to the current time">
					<StackPanel Orientation="Horizontal" Spacing="6">
						<FontIcon Glyph="&#xE823;" FontSize="14" />
						<TextBlock Text="Now" />
					</StackPanel>
				</Button>
				<ComboBox x:Name="SpeedBox" MinWidth="170" SelectionChanged="SpeedBox_SelectionChanged"
						  ToolTipService.ToolTip="Simulation speed" />
			</StackPanel>
		</Grid>

		<!-- ======================= Main ======================= -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="260" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="330" />
			</Grid.ColumnDefinitions>

			<!-- Left rail -->
			<Grid Grid.Column="0" Background="{ThemeResource LayerFillColorAltBrush}"
				  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<TextBox x:Name="SearchBox" PlaceholderText="Search bodies…" Margin="12,12,12,8"
						 TextChanged="SearchBox_TextChanged" />

				<Expander Grid.Row="1" Header="Layers" IsExpanded="True" Margin="8,0,8,4"
						  HorizontalAlignment="Stretch">
					<StackPanel Padding="8,2,8,8" Spacing="0">
						<ToggleSwitch x:Name="TogglePlanets" Header="Planets" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
						<ToggleSwitch x:Name="ToggleMoons" Header="Moons" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
						<ToggleSwitch x:Name="ToggleOrbits" Header="Orbits" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
						<ToggleSwitch x:Name="ToggleTrails" Header="Trails" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
						<ToggleSwitch x:Name="ToggleLabels" Header="Labels" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
						<ToggleSwitch x:Name="ToggleStars" Header="Stars" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
						<ToggleSwitch x:Name="ToggleBelt" Header="Asteroid belt" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
						<ToggleSwitch x:Name="ToggleSmallBodies" Header="Small bodies" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
					</StackPanel>
				</Expander>

				<ListView x:Name="BodiesList" Grid.Row="2" SelectionMode="Single"
						  SelectionChanged="BodiesList_SelectionChanged" Margin="0,4,0,0"
						  ItemsSource="{x:Bind BodyRows}">
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="local:BodyRow">
							<Grid Padding="12,6">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<FontIcon Grid.Column="0" Glyph="{x:Bind Icon}" FontSize="14"
										  Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" />
								<StackPanel Grid.Column="1">
									<TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
									<TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
											   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
								</StackPanel>
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Grid>

			<!-- Center: 3D view -->
			<Grid Grid.Column="1">
				<WebView2 x:Name="WebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
						  DefaultBackgroundColor="Black" />
				<ProgressRing x:Name="LoadingRing" IsActive="True" Width="44" Height="44" />
				<Border x:Name="ErrorBar" HorizontalAlignment="Stretch" VerticalAlignment="Top"
						Margin="16" Padding="14,10"
						Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
						BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
						BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<FontIcon Glyph="&#xE783;" />
						<TextBlock x:Name="ErrorText" TextWrapping="Wrap" MaxWidth="720" />
					</StackPanel>
				</Border>
			</Grid>

			<!-- Inspector -->
			<Grid Grid.Column="2" Padding="16"
				  Background="{ThemeResource LayerFillColorAltBrush}"
				  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock Text="Inspector" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

				<StackPanel x:Name="InspectorEmpty" Grid.Row="1" Margin="0,32,0,0" Spacing="8">
					<FontIcon Glyph="&#xE707;" FontSize="40" HorizontalAlignment="Center"
							  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					<TextBlock Text="Select a body" HorizontalAlignment="Center"
							   Style="{StaticResource BodyStrongTextBlockStyle}" />
					<TextBlock Text="Click a planet in the 3D view, or pick one from the list."
							   TextWrapping="Wrap" HorizontalAlignment="Center"
							   Style="{StaticResource CaptionTextBlockStyle}"
							   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				</StackPanel>

				<StackPanel x:Name="InspectorBody" Grid.Row="1" Visibility="Collapsed" Spacing="10">
					<StackPanel Spacing="0">
						<TextBlock x:Name="InspectorName" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
						<TextBlock x:Name="InspectorKind" Style="{StaticResource CaptionTextBlockStyle}"
								   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
					</StackPanel>
					<ItemsControl x:Name="InspectorRows">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:InspectorRow">
								<Grid Padding="0,4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="140" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="{x:Bind Label}" TextWrapping="Wrap"
											   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
									<TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap"
											   FontWeight="Medium" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<TextBlock x:Name="InspectorDescription" TextWrapping="Wrap"
							   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							   Style="{StaticResource CaptionTextBlockStyle}" />
					<Button x:Name="FocusButton" Click="FocusButton_Click" HorizontalAlignment="Stretch">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<FontIcon Glyph="&#xE8A3;" FontSize="14" />
							<TextBlock Text="Focus camera" />
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>
		</Grid>

		<!-- ======================= Time bar ======================= -->
		<Grid Grid.Row="2" Padding="20,10"
			  Background="{ThemeResource LayerFillColorDefaultBrush}"
			  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
			  BorderThickness="0,1,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
				<TextBlock Text="Simulated time" VerticalAlignment="Center"
						   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
				<TextBlock x:Name="SimClockText" VerticalAlignment="Center" FontWeight="SemiBold" />
				<DatePicker x:Name="DatePicker" DateChanged="DatePicker_DateChanged" />
				<TimePicker x:Name="TimePicker" SelectedTimeChanged="TimePicker_TimeChanged" />
			</StackPanel>

			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
				<ToggleButton x:Name="PlayButton" Click="PlayButton_Click"
							  ToolTipService.ToolTip="Play / pause simulation" Width="40" Height="40">
					<FontIcon x:Name="PlayIcon" Glyph="&#xE769;" FontSize="16" />
				</ToggleButton>
				<TextBlock x:Name="FpsText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
						   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			</StackPanel>
		</Grid>
	</Grid>
</Window>
