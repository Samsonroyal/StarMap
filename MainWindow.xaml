<Window
    x:Class="StarMap.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:StarMap"
    mc:Ignorable="d"
    Title="StarMap — Eyes on the Solar System">

    <Grid x:Name="RootGrid" Background="#010205" KeyDown="RootGrid_KeyDown">
        <WebView2 x:Name="WebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DefaultBackgroundColor="Black" />
        <Border x:Name="LoadingOverlay" Background="#010205" Canvas.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <ProgressRing x:Name="LoadingRing" IsActive="True" Width="46" Height="46" Foreground="{StaticResource StarMapGreenBrush}" />
                <TextBlock Text="Loading the solar system" FontSize="15" FontWeight="SemiBold" CharacterSpacing="45" HorizontalAlignment="Center" />
                <TextBlock Text="Preparing live positions and planetary systems…" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Header -->
        <Grid x:Name="HeaderDragRegion" VerticalAlignment="Top" Height="68" Padding="20,8,152,8">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F0000000" Offset="0" />
                    <GradientStop Color="#A6000000" Offset="0.7" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="HomeButton" Style="{StaticResource ChromeButtonStyle}" Click="HomeButton_Click" Padding="0,0,14,0" ToolTipService.ToolTip="Solar system overview">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Grid Width="40" Height="40">
                        <Ellipse Stroke="#D7D8DC" StrokeThickness="1" />
                        <Ellipse Width="30" Height="11" Stroke="#899099" StrokeThickness="1" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform Angle="-24" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text="S" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="EYES ON THE SOLAR SYSTEM" FontWeight="SemiBold" FontSize="15" CharacterSpacing="45" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" x:Name="BreadcrumbPanel" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Visibility="Collapsed">
                <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="#7E8188" />
                <TextBlock x:Name="BreadcrumbText" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Style="{StaticResource ChromeButtonStyle}" Click="SearchTopButton_Click" ToolTipService.ToolTip="Search (Ctrl+F)"><FontIcon Glyph="&#xE721;" FontSize="17" /></Button>
                <Button Style="{StaticResource ChromeButtonStyle}" Click="ShareButton_Click" ToolTipService.ToolTip="Copy scene summary">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72D;" FontSize="16" /><TextBlock Text="Share" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ChromeButtonStyle}" Click="MenuButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE700;" FontSize="17" /><TextBlock Text="Menu" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Left contextual panel -->
        <Grid x:Name="SidebarShell" Width="370" Margin="16,82,0,112" HorizontalAlignment="Left" VerticalAlignment="Stretch">
            <Border Style="{StaticResource OverlayPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="8,6" BorderBrush="#28FFFFFF" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="ExploreTabButton" Style="{StaticResource PanelTabStyle}" Click="ExploreTabButton_Click" Background="#25FFFFFF">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE71E;" FontSize="13" /><TextBlock Text="EXPLORE" /></StackPanel>
                            </Button>
                            <Button x:Name="InfoTabButton" Style="{StaticResource PanelTabStyle}" Click="InfoTabButton_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE946;" FontSize="13" /><TextBlock Text="INFO" /></StackPanel>
                            </Button>
                            <Button x:Name="ViewTabButton" Style="{StaticResource PanelTabStyle}" Click="ViewTabButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE890;" FontSize="13" /><TextBlock Text="VIEW" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ChromeButtonStyle}" Click="ToggleSidebarButton_Click" ToolTipService.ToolTip="Collapse panel"><FontIcon Glyph="&#xE76B;" FontSize="13" /></Button>
                    </Grid>

                    <Grid x:Name="ExplorePanel" Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Padding="18,16,18,8" Spacing="5">
                            <TextBlock Text="Explore the system" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="Choose a destination or search the live catalog." Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                        </StackPanel>
                        <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="Search planets, moons, asteroids…" Margin="16,8,16,10" TextChanged="SearchBox_TextChanged">
                            <TextBox.Header><TextBlock Text="DESTINATIONS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="170" Foreground="#8E9198" /></TextBox.Header>
                        </TextBox>
                        <ListView x:Name="BodiesList" Grid.Row="2" SelectionMode="Single" SelectionChanged="BodiesList_SelectionChanged" Margin="8,0,8,8" ItemsSource="{x:Bind BodyRows}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="3" /><Setter Property="Margin" Value="0,1" /></Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:BodyRow">
                                    <Grid Padding="8,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid Width="22" Height="22" VerticalAlignment="Center"><Ellipse Stroke="#7F8790" StrokeThickness="1" /><Ellipse Width="5" Height="5" Fill="#D6A54A" /></Grid>
                                        <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /></StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Foreground="#73767D" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <ScrollViewer x:Name="InfoPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="20,18,20,22" Spacing="14">
                            <StackPanel x:Name="InspectorEmpty" Spacing="10" Margin="0,40,0,0"><FontIcon Glyph="&#xE707;" FontSize="42" Foreground="#6E737B" HorizontalAlignment="Center" /><TextBlock Text="Select a destination" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel x:Name="InspectorBody" Visibility="Collapsed" Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="InspectorName" FontSize="28" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="9" Height="9" Fill="{StaticResource StarMapAmberBrush}" VerticalAlignment="Center" /><TextBlock x:Name="InspectorKind" FontSize="13" Foreground="#D4D5D8" /></StackPanel>
                                </StackPanel>
                                <Rectangle Height="1" Fill="#30FFFFFF" />
                                <TextBlock Text="DESCRIPTION" FontSize="11" FontWeight="SemiBold" CharacterSpacing="170" Foreground="#8E9198" />
                                <TextBlock x:Name="InspectorDescription" TextWrapping="Wrap" FontSize="14" LineHeight="21" Foreground="#C4C6CA" />
                                <Button x:Name="FocusButton" Click="FocusButton_Click" HorizontalAlignment="Stretch" Background="#EAEAEC" Foreground="#111216">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A3;" FontSize="14" /><TextBlock Text="Focus camera" FontWeight="SemiBold" /></StackPanel>
                                </Button>
                                <Button x:Name="ResetBodyOrientationButton" Click="ResetBodyOrientationButton_Click" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Resume the body's physical axial rotation (R)">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE777;" FontSize="14" /><TextBlock Text="Return to physical rotation" FontWeight="SemiBold" /></StackPanel>
                                </Button>
                                <TextBlock Text="After focusing, drag directly on the body to turn it. Drag empty space to orbit above, below, or beside it." TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="ORBITAL DATA" FontSize="11" FontWeight="SemiBold" CharacterSpacing="170" Foreground="#8E9198" Margin="0,6,0,0" />
                                <ItemsControl x:Name="InspectorRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:InspectorRow">
                                            <Grid Padding="0,7" BorderBrush="#24FFFFFF" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" Foreground="#92959C" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ViewPanel" Grid.Row="1" Visibility="Collapsed">
                        <StackPanel Padding="20,18,20,22" Spacing="6">
                            <TextBlock Text="View options" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="Tune what appears in the simulation." Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,0,0,14" />
                            <ToggleSwitch x:Name="TogglePlanets" Header="Planets" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
                            <ToggleSwitch x:Name="ToggleMoons" Header="Moons" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
                            <ToggleSwitch x:Name="ToggleSmallBodies" Header="Asteroids &amp; comets" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
                            <Rectangle Height="1" Fill="#30FFFFFF" Margin="0,8" />
                            <ToggleSwitch x:Name="ToggleOrbits" Header="Orbit paths" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
                            <ToggleSwitch x:Name="ToggleTrails" Header="Motion trails" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
                            <ToggleSwitch x:Name="ToggleLabels" Header="Labels" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
                            <ToggleSwitch x:Name="ToggleStars" Header="Star field" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
                            <ToggleSwitch x:Name="ToggleBelt" Header="Asteroid belt" IsOn="True" OnContent="" OffContent="" Toggled="Toggle_Toggled" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Button x:Name="RestoreSidebarButton" Style="{StaticResource RailButtonStyle}" Width="34" Height="36" Margin="16,90,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Click="ToggleSidebarButton_Click" ToolTipService.ToolTip="Open panel"><FontIcon Glyph="&#xE76C;" FontSize="12" /></Button>

        <!-- Camera tools -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" Spacing="5">
            <Button Style="{StaticResource RailButtonStyle}" Click="ResetViewButton_Click" ToolTipService.ToolTip="System overview (Home)"><FontIcon Glyph="&#xE80F;" FontSize="16" /></Button>
            <Button Style="{StaticResource RailButtonStyle}" Click="LayersButton_Click" ToolTipService.ToolTip="Layers"><FontIcon Glyph="&#xE81E;" FontSize="17" /></Button>
            <Button Style="{StaticResource RailButtonStyle}" Click="ZoomInButton_Click" ToolTipService.ToolTip="Zoom in"><FontIcon Glyph="&#xE710;" FontSize="17" /></Button>
            <Button Style="{StaticResource RailButtonStyle}" Click="ZoomOutButton_Click" ToolTipService.ToolTip="Zoom out"><FontIcon Glyph="&#xE71F;" FontSize="17" /></Button>
            <Button x:Name="LightingButton" Style="{StaticResource RailButtonStyle}" Click="LightingButton_Click" ToolTipService.ToolTip="Toggle flood lighting"><FontIcon Glyph="&#xE706;" FontSize="17" /></Button>
        </StackPanel>

        <!-- Time console -->
        <Grid VerticalAlignment="Bottom" Margin="0,0,0,22" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,22,0"><TextBlock Text="● LIVE" Foreground="{StaticResource StarMapGreenBrush}" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="FpsText" Text="— fps" Foreground="#777B82" FontSize="11" HorizontalAlignment="Right" /></StackPanel>
            <Border Grid.Column="1" Style="{StaticResource OverlayPanelStyle}" MinWidth="690" Padding="16,11,16,8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><DatePicker x:Name="DatePicker" DateChanged="DatePicker_DateChanged" /><TimePicker x:Name="TimePicker" SelectedTimeChanged="TimePicker_TimeChanged" /></StackPanel>
                    <ComboBox x:Name="SpeedBox" Grid.Column="1" MinWidth="150" HorizontalAlignment="Center" SelectionChanged="SpeedBox_SelectionChanged" ToolTipService.ToolTip="Simulation rate" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                        <Button x:Name="NowButton" Style="{StaticResource ChromeButtonStyle}" Click="NowButton_Click" ToolTipService.ToolTip="Jump to now"><TextBlock Text="NOW" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100" Foreground="{StaticResource StarMapGreenBrush}" /></Button>
                        <ToggleButton x:Name="PlayButton" Click="PlayButton_Click" Width="38" Height="36" ToolTipService.ToolTip="Play / pause (Space)"><FontIcon x:Name="PlayIcon" Glyph="&#xE769;" FontSize="15" /></ToggleButton>
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="4,9,4,0">
                        <Rectangle Height="1" Fill="#5AFFFFFF" VerticalAlignment="Center" /><Ellipse Width="14" Height="14" Fill="{StaticResource StarMapGreenBrush}" Stroke="#D9FFFFFF" StrokeThickness="1" HorizontalAlignment="Center" />
                        <TextBlock x:Name="SimClockText" Text="Loading simulation time…" FontSize="10" Foreground="#8C9098" HorizontalAlignment="Right" Margin="0,16,0,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="ToastBar" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,78,0,0" Padding="14,9" Background="#F028292D" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="3" Visibility="Collapsed"><TextBlock x:Name="ToastText" FontSize="12" /></Border>
        <Border x:Name="ErrorBar" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,78,0,0" Padding="14,10" Background="#E8491016" BorderBrush="#FFD65B65" BorderThickness="1" CornerRadius="3" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE783;" /><TextBlock x:Name="ErrorText" TextWrapping="Wrap" MaxWidth="720" /></StackPanel>
        </Border>
    </Grid>
</Window>
