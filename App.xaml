<Application
    x:Class="StarMap.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StarMap"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="StarMapGreen">#45E69A</Color>
            <Color x:Key="StarMapAmber">#D6A54A</Color>
            <SolidColorBrush x:Key="StarMapGreenBrush" Color="{StaticResource StarMapGreen}" />
            <SolidColorBrush x:Key="StarMapAmberBrush" Color="{StaticResource StarMapAmber}" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#E617181B" />
            <SolidColorBrush x:Key="OverlayStrokeBrush" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#AEB1B8" />

            <Style x:Key="OverlayPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource OverlayStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
            </Style>
            <Style x:Key="ChromeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#E9E9EC" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="RailButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#D91A1B1E" />
                <Setter Property="BorderBrush" Value="#30FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="PanelTabStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="MinHeight" Value="34" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
